---
layout: null
---
<!DOCTYPE html>
<html lang="{{ site.lang | default: 'en' }}">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="{{ page.description | default: site.description | strip_html | strip_newlines | truncate: 160 }}">
  <meta name="author" content="{{ site.first_name }} {{ site.last_name }}">
  <meta property="og:title" content="{{ site.first_name }} {{ site.last_name }}">
  <meta property="og:type" content="website">
  <title>{{ site.title | default: site.first_name | append: ' ' | append: site.last_name }}</title>
  <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><text y=%22.9em%22 font-size=%2290%22>{{ site.icon }}</text></svg>">
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Merriweather:wght@300;400;500;600&display=swap">
  {% al_icons_styles %}
  <link rel="stylesheet" href="{{ '/assets/css/custom-theme.css' | relative_url }}">
</head>
<body id="top">
  <header>
    <div class="header-content">
      <h1>{{ site.first_name }}{% if site.middle_name %} {{ site.middle_name }}{% endif %} {{ site.last_name }}</h1>
      {% if page.subtitle %}<p class="subtitle">{{ page.subtitle }}</p>{% endif %}
      <div class="social-links-header">
        {% if site.data.socials.email %}<a href="mailto:{{ site.data.socials.email }}"><i class="fa-solid fa-envelope"></i>Email</a>{% endif %}
        {% if site.data.socials.scholar_userid %}<a href="https://scholar.google.com/citations?user={{ site.data.socials.scholar_userid }}" target="_blank"><i class="fa-solid fa-graduation-cap"></i>Google Scholar</a>{% endif %}
        {% if site.data.socials.github_username %}<a href="https://github.com/{{ site.data.socials.github_username }}" target="_blank"><i class="fa-brands fa-github"></i>GitHub</a>{% endif %}
        {% if site.data.socials.linkedin_username %}<a href="https://linkedin.com/in/{{ site.data.socials.linkedin_username }}" target="_blank"><i class="fa-brands fa-linkedin"></i>LinkedIn</a>{% endif %}
        {% if site.data.socials.orcid_id %}<a href="https://orcid.org/{{ site.data.socials.orcid_id }}" target="_blank"><i class="fa-brands fa-orcid"></i>ORCID</a>{% endif %}
        {% if site.data.socials.cv_pdf %}<a href="{{ site.data.socials.cv_pdf | relative_url }}" target="_blank"><i class="fa-solid fa-file"></i>CV</a>{% endif %}
      </div>
    </div>
    {% if page.profile.image %}
    <div class="header-image">
      <img src="{{ page.profile.image | prepend: '/assets/img/' | relative_url }}" alt="Profile Photo" {% if page.profile.image_circular %}class="circular"{% endif %}>
    </div>
    {% endif %}
  </header>

  <main>
    <section id="about">
      {{ content }}
      {% if page.profile.more_info %}
      <div class="more-info">{{ page.profile.more_info }}</div>
      {% endif %}
    </section>

    {% if page.education.enabled and page.education.items.size > 0 %}
    <section id="education">
      <h2>Education</h2>
      {% for edu in page.education.items %}
      <div class="education-item">
        <div class="edu-header">
          <span class="edu-school">{{ edu.school }}</span>
          {% if edu.dates %}<span class="edu-dates">{{ edu.dates }}</span>{% endif %}
        </div>
        <div class="edu-degree">{{ edu.degree }}</div>
        {% if edu.details %}<div class="edu-details">{{ edu.details }}</div>{% endif %}
        {% if edu.coursework %}<div class="edu-coursework">{{ edu.coursework }}</div>{% endif %}
      </div>
      {% endfor %}
    </section>
    {% endif %}

    {% if page.skills.enabled and page.skills.categories.size > 0 %}
    <section id="skills">
      <h2>Skills</h2>
      {% for cat in page.skills.categories %}
      <div class="skill-category">
        <span class="skill-title">{{ cat.title }}:</span> <span class="skill-list">{{ cat.items }}</span>
      </div>
      {% endfor %}
    </section>
    {% endif %}

    {% if page.experience.enabled and page.experience.items.size > 0 %}
    <section id="experience">
      <h2>Experience</h2>
      {% for job in page.experience.items %}
      <div class="experience-item">
        <div class="exp-header">
          <span class="exp-title">{{ job.title }}</span>{% if job.org %}, <span class="exp-org">{{ job.org }}</span>{% endif %}
          {% if job.dates %}<span class="exp-dates">{{ job.dates }}</span>{% endif %}
        </div>
        {% if job.bullets %}
        <ul class="exp-bullets">
          {% for bullet in job.bullets %}<li>{{ bullet }}</li>{% endfor %}
        </ul>
        {% endif %}
      </div>
      {% endfor %}
    </section>
    {% endif %}

    {% if page.research_statement or page.projects.enabled %}
    <section id="research">
      <h2>Research</h2>
      {% if page.research_statement %}<p>{{ page.research_statement }}</p>{% endif %}
      {% if page.projects.enabled and page.projects.items.size > 0 %}
      <div class="projects-list">
        {% for project in page.projects.items %}
        <div class="project-item">
          <div class="project-header">
            <span class="project-title">{{ project.title }}</span>
            {% if project.dates %}<span class="project-dates">{{ project.dates }}</span>{% endif %}
          </div>
          {% if project.tech %}<div class="project-tech">{{ project.tech }}</div>{% endif %}
          {% if project.bullets %}
          <ul class="project-bullets">
            {% for bullet in project.bullets %}<li>{{ bullet }}</li>{% endfor %}
          </ul>
          {% endif %}
        </div>
        {% endfor %}
      </div>
      {% if page.projects.github %}
      <p class="projects-link"><a href="{{ page.projects.github }}" target="_blank"><i class="fa-brands fa-github"></i> More projects on GitHub</a></p>
      {% endif %}
      {% endif %}
    </section>
    {% endif %}

    {% if page.selected_papers %}
    <section id="publications">
      <div class="publications-header">
        <h2>Selected Publications</h2>
        <button id="toggle-publications" class="toggle-publications" onclick="toggleAlFolioPublications()">Show All</button>
      </div>
      <div id="pub-selected">
        {% bibliography -f papers -q @*[selected=true] %}
      </div>
      <div id="pub-all" style="display:none;">
        {% bibliography -f papers %}
      </div>
    </section>
    <script>
      function toggleAlFolioPublications() {
        var selected = document.getElementById('pub-selected');
        var all = document.getElementById('pub-all');
        var btn = document.getElementById('toggle-publications');
        var showingAll = all.style.display !== 'none';
        selected.style.display = showingAll ? '' : 'none';
        all.style.display = showingAll ? 'none' : '';
        btn.textContent = showingAll ? 'Show All' : 'Show Selected';
      }
    </script>
    {% endif %}

    {% if page.announcements.enabled %}
    {% assign news_items = site.news | reverse %}
    {% if page.announcements.limit %}{% assign news_items = news_items | slice: 0, page.announcements.limit %}{% endif %}
    {% if news_items.size > 0 %}
    <section id="news">
      <h2>News</h2>
      <div class="news-container{% if page.announcements.scrollable %} scrollable{% endif %}">
        <ul class="news-list">
          {% for item in news_items %}
          <li>{{ item.date | date: "%m/%Y" }}: {{ item.content | markdownify | remove: '<p>' | remove: '</p>' }}</li>
          {% endfor %}
        </ul>
      </div>
    </section>
    {% endif %}
    {% endif %}

    {% if page.awards.enabled and page.awards.items.size > 0 %}
    <section id="awards">
      <h2>Awards</h2>
      {% for award in page.awards.items %}
      <div class="award-item">
        <span class="award-year">{{ award.year }}</span>
        <div class="award-desc">{{ award.description }}</div>
      </div>
      {% endfor %}
    </section>
    {% endif %}

    {% if page.competitions.enabled and page.competitions.items.size > 0 %}
    <section id="competitions">
      <h2>Competitions</h2>
      {% for comp in page.competitions.items %}
      <div class="service-category">
        <div class="service-title">{{ comp.title }}</div>
        <p>{{ comp.description }}</p>
      </div>
      {% endfor %}
    </section>
    {% endif %}

    {% if page.services.enabled and page.services.items.size > 0 %}
    <section id="services">
      <h2>Services</h2>
      {% for service in page.services.items %}
      <div class="service-category">
        <div class="service-title">{{ service.title }}</div>
        <p>{{ service.org }}</p>
      </div>
      {% endfor %}
    </section>
    {% endif %}

    {% if page.miscellaneous.enabled and page.miscellaneous.items.size > 0 %}
    <section id="miscellaneous">
      <h2>Miscellaneous</h2>
      {% for note in page.miscellaneous.items %}
      <div class="misc-item">{{ note | markdownify }}</div>
      {% endfor %}
    </section>
    {% endif %}
  </main>

  <footer>
    {{ site.footer_text }}
  </footer>
</body>
</html>
